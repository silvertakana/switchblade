# Copy this file to `.env` and fill in the keys for the backends you use.
# The router reads these at request time. Never commit the real .env.
# Key names are referenced from config.json via `apiKeyEnv`.

# OpenCode Go accounts (optional - used for deepseek-v4-flash/pro via GO)
OPENCODE_GO_KEY=
OPENCODE_GO_ALT_KEY=
OPENCODE_GO_ALT2_KEY=
OPENCODE_GO_ALT3_KEY=

# DeepSeek direct API (optional - deepseek-v4-flash/pro direct fallback)
DEEPSEEK_API_KEY=

# CommandCode.ai provider API (optional - aggregator: GLM, MiMo, DeepSeek, Laguna free)
COMMANDCODE_API_KEY=
COMMANDCODE_ALT_API_KEY=

# Z.ai / Zhipu (optional - GLM 5.3, incl. coding plan subscription)
ZAI_API_KEY=

# Master key for chat/admin auth (config.json `masterKeyEnv`) - the value dsh and
# OpenCode already send as `Authorization: Bearer`. Used by both the local
# (config.json) and server (config.server.json) configs.
LITELLM_API_KEY=

# Dashboard password - when set (config.json `uiPasswordEnv`), the web UI
# requires this password to log in. Leave empty to keep the UI open.
LMR_UI_PASSWORD=

# Optional: separate master key value, if you ever rotate LITELLM_API_KEY and
# want to point config.json `masterKeyEnv` at LMR_MASTER_KEY instead without
# touching the key dsh/OpenCode send.
LMR_MASTER_KEY=
